{
  "name": "bitajon-frontend",
  "private": true,
  "version": "0.2.0",
  "description": "Frontend de BITAJÓN: donaciones con trazabilidad on-chain en Stellar.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:bindings": "node scripts/sync-bindings.mjs",
