    "@lobstrco/signer-extension-api": "^1.0.0-beta.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "@walletconnect/core": "^2.26.0",
    "@walletconnect/sign-client": "^2.26.0",
    "buffer": "^6.0.3",
    "lucide-react": "^1.69.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
